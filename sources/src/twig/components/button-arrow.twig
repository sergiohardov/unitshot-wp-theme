{% if type == 'link' %}
    <a href="{{ link }}" class="us-button-arrow {% if version %} us-button-arrow--{{ version }} {% endif %} {{ class }} {% if disabled %} us-button-arrow--link-disabled {% endif %}"></a>
{% else %}
    <button class="us-button-arrow {% if version %} us-button-arrow--{{ version }} {% endif %} {{ class }}" {% if disabled %} disabled {% endif %}></button>
{% endif %}
